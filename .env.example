# Dipakai oleh server dan client saat development.

# --- Server ---
RALLYUP_ADDR=:8080
RALLYUP_DATABASE_URL=postgres://rallyup:rallyup@localhost:5432/rallyup?sslmode=disable
RALLYUP_JWT_SECRET=ganti-dengan-string-acak-panjang
RALLYUP_ACCESS_TOKEN_TTL=15m
RALLYUP_REFRESH_TOKEN_TTL=336h
RALLYUP_CORS_ORIGINS=http://localhost:5173
RALLYUP_ENV=development

# --- Client (di- prefix VITE) ---
VITE_API_BASE_URL=/api/v1
